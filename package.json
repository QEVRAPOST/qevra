{
  "name": "qevra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:copy": "node scripts/copy-lint.mjs",
    "test": "node --import ./tests/register-test-hooks.mjs --import tsx --test tests/*.test.ts",
    "security:worker": "node --conditions=react-server --import tsx src/features/security/worker-main.ts",
    "robinhood:rpc:testnet": "bun scripts/robinhood.ts rpc testnet",
    "robinhood:rpc:mainnet": "bun scripts/robinhood.ts rpc mainnet",
    "robinhood:contracts:build": "bun scripts/robinhood.ts contracts build",
    "robinhood:contracts:size": "bun scripts/robinhood.ts contracts size",
    "robinhood:contracts:gas": "bun scripts/robinhood.ts contracts gas",
    "robinhood:deploy:validate": "bun scripts/robinhood.ts deploy validate testnet",
    "robinhood:deploy:dry-run": "bun scripts/robinhood.ts deploy dry-run testnet",
    "robinhood:explorer:readiness": "bun scripts/robinhood.ts explorer readiness testnet",
    "deploy:simulate": "bun scripts/deploy-simulate.ts",
    "deploy:show": "bun scripts/deploy-simulate.ts"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
