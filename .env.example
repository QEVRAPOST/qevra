# Use at least 32 random bytes for each secret. Never commit real values.
NEXT_PUBLIC_PROJECT_NAME=VEYRA
QEVRA_APP_MODE=demo
QEVRA_ACCESS_TOKEN=replace-with-a-32-byte-or-longer-operator-token
QEVRA_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Email/password accounts and ordinary EIP-191 user sessions use PostgreSQL, a separate
# session secret, and a fixed public origin. Password hashes use Node scrypt.
VEYRA_USER_SESSION_SECRET=replace-with-a-different-32-byte-or-longer-secret
VEYRA_AUTH_ORIGIN=https://veyra.example

# Built-in wallet creation is intentionally unavailable until an embedded provider is
# integrated and recovery/export have passed user acceptance testing. No private keys
# or seed phrases are stored by VEYRA.

# Optional app-wide social authentication providers. Configure only after their callbacks/senders are ready.
# Google OAuth redirect URI must be: ${VEYRA_AUTH_ORIGIN}/api/auth/google/callback
VEYRA_GOOGLE_CLIENT_ID=
VEYRA_GOOGLE_CLIENT_SECRET=
# Email OTP uses Resend. The sender domain/address must be verified in the Resend account.
RESEND_API_KEY=
VEYRA_EMAIL_FROM=

# Optional Mainnet Foundry keystore alias; must be distinct from veyra-testnet.
# No private key or keystore password belongs in environment variables.
VEYRA_MAINNET_ACCOUNT=

# PostgreSQL for durable runs, worker leases, and shared rate limits.
DATABASE_URL=postgresql://qevra:replace-me@localhost:5432/qevra

# Required for model execution; choose a model supporting Chat Completions JSON mode.
# Compatible provider URL, JSON-mode model availability, cost, and research quality
# must be verified by the operator; this project has made no live provider call.
QEVRA_AI_API_KEY=replace-with-a-Groq-key-in-the-ignored-private-runtime-env
QEVRA_AI_MODEL=openai/gpt-oss-20b
QEVRA_AI_BASE_URL=https://api.groq.com/openai/v1
# Conservative one-run Groq Free Plan profile; verify account limits before use.
QEVRA_AI_MAX_OUTPUT_TOKENS=800
QEVRA_AI_MAX_REQUEST_BYTES=6000
QEVRA_AI_MIN_REQUEST_INTERVAL_MS=61000
QEVRA_AI_MODEL_SOURCE_MAX_CHARS=1200
QEVRA_AI_TIMEOUT_MS=25000
# Set to true only after the project owner explicitly approves provider billing.
QEVRA_AI_BILLING_APPROVED=false

# Server-side only: 0x Swap API v2 key for Robinhood Mainnet quotes (never NEXT_PUBLIC_*)
ZEROX_API_KEY=
# Explicit fail-closed research access mode. owner_only requires the wallet allowlist below.
# Change to public_limited only for public wallet-authenticated access.
QEVRA_RESEARCH_ACCESS_MODE=owner_only
# Comma-separated wallet addresses allowed in owner_only mode. Ignored by public_limited.
QEVRA_RESEARCH_RUN_OWNER_ALLOWLIST=
# Required server-side admission quotas; public_limited cannot exceed these hard caps:
# 60–86400 seconds per wallet, at most 20 runs/hour, 60 runs/rolling day, and 4 active runs.
QEVRA_RESEARCH_PER_WALLET_COOLDOWN_SECONDS=3600
QEVRA_RESEARCH_GLOBAL_HOURLY_RUN_LIMIT=20
QEVRA_RESEARCH_GLOBAL_DAILY_RUN_LIMIT=60
QEVRA_RESEARCH_MAX_ACTIVE_RUNS=1
QEVRA_MAX_RUN_ATTEMPTS=1

# Optional immutable Docker image containing bash, git, Python 3.10, and Foundry.
# The approved experiment remains blocked unless this includes an image SHA-256 digest.
QEVRA_EXPERIMENT_IMAGE=
QEVRA_WORKER_POLL_MS=1000
QEVRA_MAX_CONCURRENT_RUNS=1

# Built-in read-only targets: Robinhood Chain Mainnet 4663 and Testnet 46630.
